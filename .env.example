# Copy to .env for local overrides. Never commit real secrets.
JWT_SECRET=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///./homeserve.db
# Render Postgres is injected as DATABASE_URL. MySQL also works:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/homeserve
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_DIST=
